  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "var(--font-dela-gothic-one, \"Dela Gothic One\")",
        "f12DisplayFallback",
        "f12DisplayFallbackDejaVu",
        "Arial Black",
        "Helvetica Neue",
        "sans-serif"
      ],
      "$description": "Display headlines and metric numerals."
    },
    "body": {
      "$value": [
        "var(--font-zen-kaku-gothic-new, \"Zen Kaku Gothic New\")",
        "f12BodyFallback",
        "f12BodyFallbackDejaVu",
        "Hiragino Sans",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "$description": "Body copy, table cells, and descriptions."
    },
    "mono": {
      "$value": [
        "var(--font-m-plus-1-code, \"M PLUS 1 Code\")",
        "f12MonoFallbackConsolas",
        "f12MonoFallback",
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "monospace"
      ],
      "$description": "Cut labels, eyebrows, table headers, and controls."
    }
  },
  "gutter": {
    "$type": "dimension",
    "pair": {
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$description": "Tighter gap for paired panels and dense control rows."
    },
    "scene": {
      "$value": {
        "value": 20,
        "unit": "px"
      },
      "$description": "Default gap between panels within the same scene."
    },
    "change": {
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$description": "Vertical separation across a scene change."
    }
  },
  "stroke": {
    "$type": "dimension",
    "ink": {
      "$value": {
        "value": 2.5,
        "unit": "px"
      },
      "$description": "Expressive mitered ink panel and control stroke width."
    }
  },
  "motion": {
    "pose": {
      "$type": "duration",
      "$value": {
        "value": 83.33,
        "unit": "ms"
      },
      "$description": "Duration of a single animation pose held on twos at 12fps (1000ms / 12)."
    },
    "fps": {
      "$type": "number",
      "$value": 12,
      "$description": "Frames per second for stepped animation on twos."
    }
  },
  "shadow": {
    "$type": "shadow",
    "sheet": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.05
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 0, "unit": "px" },
          "spread": { "value": 0, "unit": "px" },
          "inset": false
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.5
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 18, "unit": "px" },
          "blur": { "value": 40, "unit": "px" },
          "spread": { "value": -26, "unit": "px" },
          "inset": false
        }
      ],
      "$description": "Elevation shadow under the storyboard sheet."
    },
    "peg": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.25
        },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" },
        "inset": true
      },
      "$description": "Inset depth shadow inside registration peg holes."
    }
  }
}

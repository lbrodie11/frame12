        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Interior panel fill surface.",
      "$extensions": {
        "dev.frame12.scope": "themed",
        "dev.frame12.modes": {
          "light": {
            "colorSpace": "srgb",
            "components": [1, 1, 1],
            "alpha": 1,

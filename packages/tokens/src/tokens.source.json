{
  "$description": "FRAME/12 design tokens — canonical W3C DTCG 2025.10 source for Paper Light and Flashback Dark modes, font stacks, legal gutters (12/20/32px), 2.5px ink stroke, and 12fps on-twos motion.",
  "$extensions": {
    "dev.frame12.spec": "https://www.designtokens.org/tr/2025.10/format/",
    "dev.frame12.defaultMode": "light",
    "dev.frame12.modes": ["light", "dark"]
  },
  "color": {
    "$type": "color",
    "desk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8863, 0.8902, 0.898],
        "alpha": 1,
        "hex": "#e2e3e5"
      },
      "$description": "Surrounding animation desk surface behind the storyboard sheet.",
      "$extensions": {
        "dev.frame12.scope": "themed",
        "dev.frame12.modes": {
          "light": {
            "colorSpace": "srgb",
            "components": [0.8863, 0.8902, 0.898],
            "alpha": 1,
            "hex": "#e2e3e5"
          },
          "dark": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 1,
            "hex": "#000000"
          }
        }
      }
    },
    "sheet": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Primary comic page / storyboard sheet surface.",
      "$extensions": {
        "dev.frame12.scope": "themed",
        "dev.frame12.modes": {
          "light": {
            "colorSpace": "srgb",
            "components": [1, 1, 1],
            "alpha": 1,
            "hex": "#ffffff"
          },
          "dark": {
            "colorSpace": "srgb",
            "components": [0.0196, 0.0196, 0.0196],
            "alpha": 1,
            "hex": "#050505"
          }
        }
      }
    },

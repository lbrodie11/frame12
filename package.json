{
  "name": "frame12",
  "version": "0.1.0",
  "private": true,
  "description": "FRAME/12: an interface design language from animation and manga production craft.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "lab",
    "registry",
    "eval",
    "site",
    "templates/next-starter"
  ],
  "scripts": {
    "sync:workspaces": "node scripts/sync-workspaces.mjs",
    "sync:check": "node scripts/sync-workspaces.mjs --check",
    "doc:check": "node scripts/check-doc-sync.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint:frame12": "node scripts/check-frame12.mjs registry/ui registry/blocks eval/screens site/src site/app templates/next-starter/app templates/next-starter/src",
    "test:cross-browser": "npm --workspace=@frame12/registry run test:cross-browser",
    "test": "npm run sync:check && npm run doc:check && npm run lint:frame12 && npm run test --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "postcss": "^8.5.23"
  }
}

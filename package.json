{
  "name": "frame12",
  "version": "0.1.0",
  "private": true,
  "description": "FRAME/12: an interface design language from animation and manga production craft.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "lab",
    "registry",
    "eval",
    "site"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint:frame12": "node scripts/check-frame12.mjs registry/ui eval/screens",
    "test": "npm run lint:frame12 && npm run test --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}

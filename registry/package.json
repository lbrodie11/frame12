{
  "name": "@frame12/registry",
  "version": "0.2.0",
  "private": true,
  "description": "FRAME/12 component source and shadcn registry.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:gallery": "node scripts/build.mjs",
    "build:registry": "npx shadcn build registry.json -o ../site/public/r && node -e \"const fs=require('fs');fs.copyFileSync('registry.json','../site/public/r/registry.json')\"",
    "build": "npm run build:gallery && npm run build:registry",
    "test:unit": "node tests/unit.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:cross-browser": "npm run build:gallery && node tests/cross-browser.mjs",
    "test": "npm run build:gallery && npm run test:unit && npm run test:a11y && node tests/cross-browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
